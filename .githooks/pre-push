#!/bin/sh
set -eu

is_empty_root() {
    [ "$(git --no-replace-objects cat-file -t "$1" 2>/dev/null)" = commit ] || return 1
    [ -z "$(git --no-replace-objects cat-file -p "$1" | sed -n '/^$/q; /^parent /p')" ] || return 1
    [ "$(git --no-replace-objects rev-parse "$1^{tree}")" = "$(git hash-object -t tree --stdin </dev/null)" ]
}

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            case "$remote_oid" in
                ''|*[!0]*) ;;
                *)
                    if [ "$remote_ref" = refs/heads/main ] && is_empty_root "$local_oid"; then
                        continue
                    fi
                    ;;
            esac
            echo "Push a feature branch and merge through a PR; direct protected-branch pushes are blocked." >&2
            exit 1
            ;;
    esac
done
